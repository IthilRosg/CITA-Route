<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>Cita.NativeAgentLab</AssemblyName><NuGetAudit>false</NuGetAudit><DefineConstants>$(DefineConstants);CITA_DPI_LAB</DefineConstants>
  </PropertyGroup>
  <!-- Keep the lab coupled to the complete Native* source surface. The
       production agent grows cross-component dependencies; a hand-maintained
       subset silently fell behind and made queue/resource gates unbuildable. -->
  <ItemGroup>
    <Compile Include="../../agent/Native*.cs" Link="%(Filename)%(Extension)" />
    <!-- Service-host files depend on the full AgentHost/State graph and are
         outside this deterministic lab's scope. -->
    <Compile Remove="../../agent/NativeService.cs" />
    <Compile Remove="../../agent/NativeMaintenanceValidation.cs" />
    <Compile Remove="../../agent/NativeMaintenanceValidationTests.cs" />
  </ItemGroup>
</Project>
