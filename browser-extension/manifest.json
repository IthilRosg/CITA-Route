{
  "manifest_version": 3,
  "name": "CITA Route — Browser Feedback",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Сообщает CITA Route о сетевых ошибках ресурсов. Передаёт только домен и тип ошибки.",
  "key": "",
  "permissions": [
    "webRequest",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CITA Route"
  },
  "content_scripts": [
    {
      "all_frames": false,
      "js": [
        "images.js"
      ],
      "run_at": "document_start",
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "incognito": "not_allowed"
}