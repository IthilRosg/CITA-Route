<Window x:Class="RoutePilot.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:RoutePilot" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="CITA Route — умный роутинг" Width="1360" Height="900" MinWidth="1120" MinHeight="760" Background="{StaticResource Bg}" Foreground="#F0EADB" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#3D3839" BorderThickness="1" CornerRadius="0">
    <Grid>
    <Grid x:Name="AdvancedHost" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#101011" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel Margin="16,24,16,20">
          <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Margin="7,0,0,0">
              <Border Width="30" Height="30" BorderBrush="{StaticResource Accent}" BorderThickness="2"><Path Data="M 7,20 L 7,7 L 20,7 M 7,14 L 20,14 M 16,3 L 20,7 L 16,11 M 16,10 L 20,14 L 16,18" Stroke="{StaticResource Text}" StrokeThickness="1.5" Width="20" Height="22" Stretch="Uniform"/></Border>
              <TextBlock Text="CITA ROUTE" FontFamily="Consolas" FontWeight="Bold" FontSize="18" Margin="10,4,0,0"/>
            </StackPanel>
            <TextBlock Text="PERSONAL GATEWAY" Style="{StaticResource Eyebrow}" Margin="8,12,0,31"/>
            <TextBlock Text="НАВИГАЦИЯ / 05" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Faint}" Margin="13,0,0,9"/>
            <RadioButton x:Name="NavOverview" AutomationProperties.Name="Обзор сети" GroupName="Nav" Style="{StaticResource Nav}" Tag="0" Checked="Navigate_Click" IsChecked="True"><StackPanel Orientation="Horizontal"><TextBlock Text="01" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,2,13,0"/><TextBlock Text="ОБЗОР" FontFamily="Consolas" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
            <RadioButton x:Name="NavConnections" AutomationProperties.Name="Соединения" GroupName="Nav" Style="{StaticResource Nav}" Tag="1" Checked="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="02" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,2,13,0"/><TextBlock Text="СОЕДИНЕНИЯ" FontFamily="Consolas" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
            <RadioButton x:Name="NavRules" AutomationProperties.Name="Маршруты" GroupName="Nav" Style="{StaticResource Nav}" Tag="2" Checked="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="03" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,2,13,0"/><TextBlock Text="МАРШРУТЫ" FontFamily="Consolas" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
            <RadioButton x:Name="NavLogs" AutomationProperties.Name="Журнал" GroupName="Nav" Style="{StaticResource Nav}" Tag="3" Checked="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="04" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,2,13,0"/><TextBlock Text="ЖУРНАЛ" FontFamily="Consolas" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
            <RadioButton x:Name="NavSettings" AutomationProperties.Name="Настройки" GroupName="Nav" Style="{StaticResource Nav}" Tag="4" Checked="Navigate_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="05" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,2,13,0"/><TextBlock Text="НАСТРОЙКИ" FontFamily="Consolas" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/></StackPanel></RadioButton>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
            <Button Content="КОМПАКТНЫЙ ВИД ↗" Click="CompactView_Click" FontSize="10" Margin="0,0,0,12" AutomationProperties.Name="Компактный вид"/>
            <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Padding="8,17,0,18"><StackPanel><TextBlock Text="ПОЛИТИКА МАРШРУТОВ" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource Faint}"/><TextBlock Text="Ограниченные сайты → VPN" FontSize="11" Margin="0,10,0,0"/><TextBlock Text="Остальное → напрямую" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></Border>
            <StackPanel Orientation="Horizontal" Margin="8,0,0,0"><Ellipse x:Name="SidebarDot" Width="6" Height="6" Fill="{StaticResource Muted}" Margin="0,0,8,0"/><TextBlock x:Name="SidebarState" Text="Отключено" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
            <TextBlock Text="CITA / X64 / 0.5.0" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource Faint}" Margin="8,11,0,0"/>
          </StackPanel>
          <Grid/>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <Grid Background="Transparent" MouseLeftButtonDown="TitleDrag" Margin="30,0,30,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Grid.ColumnSpan="2"/><TextBlock Text="CITA SYSTEMS // NETWORK CONSOLE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" FontSize="9"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="—" Width="40" Padding="0" Background="Transparent" BorderThickness="0" Click="Minimize_Click" AutomationProperties.Name="Свернуть"/><Button Content="□" Width="40" Padding="0" Background="Transparent" BorderThickness="0" Click="Maximize_Click" AutomationProperties.Name="Развернуть"/><Button Content="×" FontSize="19" Width="40" Padding="0" Background="Transparent" BorderThickness="0" Click="Close_Click" AutomationProperties.Name="Закрыть"/></StackPanel></Grid>
        <Grid Grid.Row="1" Margin="30,20,30,23"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageEyebrow" Text="01 / NETWORK OVERVIEW" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"/><TextBlock x:Name="PageTitle" Text="ОБЗОР СЕТИ" FontFamily="Bahnschrift SemiCondensed" FontSize="44" FontWeight="Bold" Margin="-1,6,0,0"/><TextBlock x:Name="PageSubtitle" Text="Состояние сети, трафик и выбор маршрутов." Foreground="{StaticResource Muted}" Margin="0,6,0,0" FontSize="13"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="DiagnosticsButton" Content="Проверить" Click="Diagnostics_Click" Margin="0,0,10,0"/><Button x:Name="ConnectButton" Content="Подключить" MinWidth="136" Style="{StaticResource Primary}" Click="Connect_Click"/></StackPanel></Grid>
        <Border x:Name="NoticeBorder" Grid.Row="2" Margin="30,0,30,16" Background="#1E1718" BorderBrush="#8F2C2B" BorderThickness="1" CornerRadius="0" Padding="13,10" Visibility="Collapsed"><TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#F0EADB" FontSize="12"/></Border>
        <TabControl x:Name="Pages" SelectedIndex="0" Grid.Row="3" Margin="30,0,30,0" Foreground="#F0EADB" Background="Transparent" BorderThickness="0">
          <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
          <TabItem>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="20,17"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Border x:Name="StatusBadge" CornerRadius="0" Background="#1B191B" Padding="7,3"><TextBlock x:Name="StatusLabel" Text="ОТКЛЮЧЕНО" FontSize="9" FontWeight="SemiBold" Foreground="#AAA297"/></Border><TextBlock Text="WIRESOCK / VPN" FontSize="9" Foreground="#AAA297" Margin="12,4,0,0"/></StackPanel><TextBlock Text="Автоматический выбор маршрута" FontSize="19" FontWeight="SemiBold" Margin="0,10,0,0"/><TextBlock x:Name="ProfileLabel" Text="Профиль: выбери подключение в настройках" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="ВРЕМЯ ПОДКЛЮЧЕНИЯ" FontSize="9" Foreground="{StaticResource Muted}"/><TextBlock x:Name="UptimeLabel" Text="—" FontSize="26" FontFamily="Consolas" HorizontalAlignment="Right" Margin="0,6,0,0"/></StackPanel></Grid></Border>
                <UniformGrid Columns="4" Margin="0,0,0,16">
                  <Border Style="{StaticResource Card}" BorderThickness="1,1,0,1" Padding="17,17" Background="{StaticResource PanelSoft}"><StackPanel><TextBlock Text="↓  ЗАГРУЗКА" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DownloadRateLabel" Text="—" FontFamily="Consolas" FontSize="27" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/><TextBlock Text="Текущая скорость" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border>
                  <Border Style="{StaticResource Card}" BorderThickness="1,1,0,1" Padding="17,17" Background="{StaticResource PanelSoft}"><StackPanel><TextBlock Text="↑  ОТДАЧА" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="UploadRateLabel" Text="—" FontFamily="Consolas" FontSize="27" Foreground="#86A9C8" Margin="0,8,0,0"/><TextBlock Text="Текущая скорость" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border>
                  <Border Style="{StaticResource Card}" BorderThickness="1,1,0,1" Padding="17,17" Background="{StaticResource PanelSoft}"><StackPanel><TextBlock Text="ТРАФИК СЕГОДНЯ" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="TodayLabel" Text="0 Б" FontFamily="Consolas" FontSize="27" Margin="0,8,0,0"/><TextBlock x:Name="LifetimeLabel" Text="Всего учтено: 0 Б" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border>
                  <Border Style="{StaticResource Card}" Padding="17,17" Background="{StaticResource PanelSoft}"><StackPanel><TextBlock Text="СОЕДИНЕНИЯ" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ConnectionCountLabel" Text="—" FontFamily="Consolas" FontSize="27" Margin="0,8,0,0"/><TextBlock Text="Активны прямо сейчас" Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel></Border>
                </UniformGrid>
                <Grid Height="210" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="2.05*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource Card}" Margin="0,0,16,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel><TextBlock Text="Скорость трафика" FontSize="15" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="●  Загрузка" FontSize="10" Foreground="{StaticResource Accent}" Margin="10,3,0,0"/><TextBlock Text="●  Отдача" FontSize="10" Foreground="#86A9C8" Margin="14,3,0,0"/></StackPanel></DockPanel><local:RateChart x:Name="TrafficChart" Grid.Row="1" Margin="0,20,0,0" AutomationProperties.Name="График скорости за последние 60 секунд"/></Grid></Border>
                  <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Маршруты сейчас" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="В активных соединениях" Style="{StaticResource Caption}" Margin="0,6,0,12"/><DockPanel><TextBlock Text="Через VPN" Foreground="{StaticResource Accent}" FontSize="12"/><TextBlock x:Name="VpnCountLabel" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold"/></DockPanel><ProgressBar x:Name="VpnShareBar" Margin="0,10,0,12" Height="5" Maximum="1" Background="#282426" Foreground="{StaticResource Accent}" BorderThickness="0"/><DockPanel><TextBlock Text="Напрямую" Foreground="#86A9C8" FontSize="12"/><TextBlock x:Name="DirectCountLabel" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold"/></DockPanel><Border BorderBrush="#3D3839" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,11,0,0"><TextBlock Text="Только новые соединения" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/></Border></StackPanel></Border>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="18,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="124"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,8"><TextBlock Text="Сейчас в сети" FontSize="15" FontWeight="SemiBold"/><Button Content="Все соединения  →" Padding="8,3" FontSize="10" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}" Click="AllConnections_Click"/></DockPanel><Grid Grid.Row="1"><DataGrid x:Name="RecentGrid"><DataGrid.Columns><DataGridTextColumn Header="Сайт / адрес" Binding="{Binding Host}" Width="*"/><DataGridTextColumn Header="Приложение" Binding="{Binding Process}" Width="170"/><DataGridTextColumn Header="Маршрут" Binding="{Binding Route}" Width="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding RouteColor}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="Загружено" Binding="{Binding Downloaded}" Width="110"/></DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyConnectionsLabel" Text="Пока нет соединений. Они появятся после подключения." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Grid></Grid></Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ConnectionSearch" ToolTip="Поиск по сайту, приложению или маршруту" TextChanged="ConnectionSearch_Changed"/><Button Grid.Column="1" Content="Закрыть выбранное соединение" Margin="12,0,0,0" Click="CloseConnection_Click"/></Grid><Border Grid.Row="1" Style="{StaticResource Card}" Padding="12"><DataGrid x:Name="ConnectionsGrid" SelectionChanged="ConnectionSelection_Changed"><DataGrid.Columns><DataGridTextColumn Header="Сайт / адрес" Binding="{Binding Host}" Width="*"/><DataGridTextColumn Header="Приложение" Binding="{Binding Process}" Width="160"/><DataGridTextColumn Header="Протокол" Binding="{Binding Network}" Width="85"/><DataGridTextColumn Header="Маршрут" Binding="{Binding Route}" Width="95"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding RouteColor}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="↓" Binding="{Binding Downloaded}" Width="95"/><DataGridTextColumn Header="↑" Binding="{Binding Uploaded}" Width="95"/></DataGrid.Columns></DataGrid></Border><TextBlock x:Name="ConnectionDetailLabel" Grid.Row="2" Margin="0,14,0,12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Text="Выбери соединение, чтобы посмотреть правило и адрес назначения."/></Grid></TabItem>
          <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
              <TextBlock Text="Выбор маршрута и обход DPI" FontSize="18" FontWeight="SemiBold"/>
              <ComboBox x:Name="RoutingModeInput" SelectedIndex="0" Margin="0,14,0,12" SelectionChanged="RoutingPolicy_Changed"><ComboBoxItem Content="Ограниченное → VPN"/><ComboBoxItem Content="Авто: напрямую / DPI / VPN · экспериментально"/></ComboBox>
              <CheckBox x:Name="AllowListedDpiBox" Content="Разрешить DPI для сайтов из списка ограничений" Checked="RoutingPolicy_Changed" Unchecked="RoutingPolicy_Changed"/>
              <TextBlock Text="Стратегия: дробление TLS-записей. Автоподбор действует для новых TCP/443-соединений после повторяемого отказа. OpenAI по умолчанию — VPN. Твои явные правила имеют приоритет. Смена режима — после переподключения." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
              <TextBlock x:Name="PolicyStateLabel" Text="Контроллер маршрутов остановлен" FontSize="12" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,12,0,0"/>
              <TextBlock x:Name="PolicyDetailLabel" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <Button Content="Очистить кэш решений" HorizontalAlignment="Left" Margin="0,12,0,0" Click="ClearPolicy_Click"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Обновляемый список ограничений" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="FeedStateLabel" Text="Россия: ограничения доступа + Discord" Margin="0,7,0,0" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="Автообновление раз в сутки, пока работает подключение" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel><Button x:Name="UpdateFeedsButton" Grid.Column="1" Content="Обновить сейчас" Click="UpdateFeeds_Click" VerticalAlignment="Center"/></Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Твои правила" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Поддомены включены. Прямые исключения имеют приоритет." Margin="0,7,0,16" Foreground="{StaticResource Muted}" FontSize="12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RuleDomainInput" ToolTip="example.com" KeyDown="RuleInput_KeyDown"/><ComboBox x:Name="RuleTargetInput" Grid.Column="1" SelectedIndex="0" Margin="12,0"><ComboBoxItem Content="Через VPN"/><ComboBoxItem Content="Напрямую"/></ComboBox><Button Grid.Column="2" Content="Добавить" Style="{StaticResource Primary}" Click="AddRule_Click"/></Grid><DataGrid x:Name="RulesGrid" Margin="0,16,0,0" Height="220"><DataGrid.Columns><DataGridTextColumn Header="Домен" Binding="{Binding Domain}" Width="*"/><DataGridTextColumn Header="Маршрут" Binding="{Binding Target}" Width="170"/></DataGrid.Columns></DataGrid><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Удалить выбранное" Click="RemoveRule_Click"/><TextBlock Text="Изменения применяются сразу к новым соединениям" Margin="16,12,0,0" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Куда пойдёт сайт?" FontSize="17" FontWeight="SemiBold"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CheckDomainInput" ToolTip="youtube.com"/><Button Grid.Column="1" Content="Проверить маршрут" Margin="12,0,0,0" Click="CheckDomain_Click"/></Grid><TextBlock x:Name="DomainResultLabel" Text="Проверка использует текущие списки и твои исключения." Foreground="{StaticResource Muted}" Margin="0,12,0,0" FontSize="12"/></StackPanel></Border>
          </StackPanel></ScrollViewer></TabItem>
          <TabItem><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,16"><TextBlock Text="События и диагностика" FontSize="17" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Обновить" Click="RefreshLogs_Click" Margin="0,0,10,0"/><Button Content="Открыть папку" Click="OpenLogs_Click"/></StackPanel></DockPanel><TextBox x:Name="LogText" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16"/><TextBlock Grid.Row="2" Text="Содержимое VPN-конфигов и приватные ключи здесь не отображаются." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,14,0,12"/></Grid></TabItem>
          <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
              <TextBlock Text="Подключение · свой WireSock" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="CliPathLabel" Text="Поиск WireSock Secure Connect…" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
              <WrapPanel Margin="0,12,0,0"><Button x:Name="FindWireSockButton" Content="Найти WireSock и профили" Click="FindWireSock_Click" Margin="0,0,10,10"/><Button x:Name="BrowseCliButton" Content="Указать CLI…" Click="BrowseCli_Click" Margin="0,0,10,10"/><Button x:Name="ImportProfileButton" Content="Импорт .conf…" Click="ImportProfile_Click" Margin="0,0,0,10"/></WrapPanel>
              <TextBlock Text="Исходный профиль WireGuard / AmneziaWG" FontSize="12" Margin="0,4,0,8"/>
              <ComboBox x:Name="ProfileInput" SelectionChanged="ProfileInput_SelectionChanged" MinWidth="300" HorizontalAlignment="Stretch"/>
              <TextBlock x:Name="ConnectionSetupLabel" Text="Выбери профиль и примени подключение на этом компьютере." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
              <Expander Header="Дополнительно: проверка IP выхода" Margin="0,12,0,0"><StackPanel Margin="0,8,0,0"><TextBlock Text="Оставь пустым: IP выхода берётся из статуса WireSock. Если клиент его не сообщает, укажи внешний IPv4 своего VPN. Он может отличаться от адреса сервера." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><TextBox x:Name="ExpectedEgressInput" Margin="0,8,0,0" ToolTip="Внешний IPv4 VPN, необязательно"/></StackPanel></Expander>
              <Button x:Name="ApplyConnectionButton" Content="Применить подключение" HorizontalAlignment="Left" Margin="0,14,0,0" Click="ApplyConnection_Click"/>
              <TextBlock x:Name="WireSockStatusLabel" Text="Проверяю WireSock…" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
              <TextBlock Text="Настройка доступна после отключения маршрута. Windows запросит права для установки службы и управления системным маршрутом." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Встроенный обход DPI" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="TLS-фрагментация · без установки отдельного обходчика" Margin="0,12,0,0"/><TextBlock Text="В режиме «Авто» проверяются прямой доступ, DPI и VPN. DPI применяется к новым соединениям, только если HTTPS-проверки прошли. Для сайтов из списка ограничений включи проверку DPI в разделе «Правила»." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Text="Область работы: IPv4, TCP/443. Для UDP, QUIC и отдельных способов блокировки может понадобиться VPN. Настройки AWG-маскировки сохраняются из твоего профиля." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel>
              <TextBlock x:Name="NativeQualitySummary" Text="Статистика туннеля WireSock появится после подключения." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,14"/>
              <Expander x:Name="QualitySetupPanel" Header="Измерение потерь UDP · дополнительно" Margin="0,0,0,20"><StackPanel Margin="0,12,0,0">
                <TextBlock Text="Для измерения нужен свой контрольный UDP-сервер. Каждый путь проверяется отдельно; пробы не переключают маршруты." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                <CheckBox x:Name="QualityEnabledBox" Content="Измерять потери проб" Margin="0,12,0,10"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Text="IPv4 контрольного сервера" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                  <TextBlock Grid.Column="1" Text="UDP-порт" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                  <TextBox x:Name="QualityAddressInput" Grid.Row="1" ToolTip="Публичный IPv4 контрольного сервера" Margin="0,0,10,0"/>
                  <TextBox x:Name="QualityPortInput" Grid.Row="1" Grid.Column="1" ToolTip="UDP-порт"/>
                </Grid>
                <TextBlock Text="Ключ контрольного сервера (64 символа)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,6"/>
                <PasswordBox x:Name="QualityKeyInput" Height="30" Background="{StaticResource PanelSoft}" Foreground="{StaticResource Text}"/>
                <Button Content="Сохранить измерение" Click="SaveQuality_Click" HorizontalAlignment="Left" Margin="0,12,0,10"/>
                <TextBlock x:Name="QualitySummary" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              </StackPanel></Expander>
              <TextBlock Text="Автономная диагностика" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="RescueStatusLabel" Text="Проверяю службу…" Foreground="{StaticResource Accent}" Margin="0,12,0,0"/>
              <TextBlock Text="Защита работает отдельно от окна приложения. Проверка WireSock сохраняет VPNUS включённым; проверка автоподключения перезапускает официальный клиент VPNUS." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <WrapPanel Margin="0,14,0,0">
                <Button x:Name="InstallRescueButton" Content="Установить / обновить службу" Click="InstallRescue_Click" Margin="0,0,10,10"/>
                <Button x:Name="GuardTestButton" Content="1. Проверить защиту" Tag="dry-run" Click="RescueTest_Click" Margin="0,0,10,10"/>
                <Button x:Name="WireSockTestButton" Content="2. Проверить WireSock" Tag="test-wiresock" Click="RescueTest_Click" Margin="0,0,10,10"/>
                <Button x:Name="SystemTestButton" Content="3. Проверить систему и DPI" Tag="test-system" Click="RescueTest_Click" Margin="0,0,10,10"/>
                <Button x:Name="VpnusTestButton" Content="Проверить перезапуск VPNUS" Tag="test-vpnus" Click="RescueTest_Click" Margin="0,0,10,10"/>
                <Button x:Name="RecoverTestButton" Content="Остановить тест / восстановить" Tag="recover" Click="RescueTest_Click" Margin="0,0,10,10"/>
              </WrapPanel>
              <TextBlock x:Name="RescueDetailLabel" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Приложение" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/><CheckBox x:Name="CloseToTrayBox" Content="Сворачивать в трей при закрытии окна" Checked="Preferences_Changed" Unchecked="Preferences_Changed"/><StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock Text="Обновлять статистику каждые" VerticalAlignment="Center" Margin="0,0,14,0"/><ComboBox x:Name="RefreshIntervalInput" Width="100" SelectionChanged="Preferences_Changed"><ComboBoxItem Content="1 сек." Tag="1"/><ComboBoxItem Content="2 сек." Tag="2"/><ComboBoxItem Content="3 сек." Tag="3"/></ComboBox></StackPanel><TextBlock Text="История трафика хранит только суммы. Диагностика и кэш маршрутов могут содержать домены и названия приложений. Журнал режима «Авто» ограничен 8 МБ." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,16,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Обновления CITA Route" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="UpdateStatusLabel" Text="Стабильные выпуски из IthilRosg/CITA-Route · GitHub Releases" Margin="0,12,0,0" TextWrapping="Wrap"/><TextBlock Text="Проверка при запуске и каждые 6 часов. Загрузка проверяется по SHA-256. Перед установкой загруженного обновления CITA Route автоматически отключает свой маршрут. Защищённая служба обновляется через «Применить подключение» с запросом Windows." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/><CheckBox x:Name="AutoInstallUpdatesBox" Content="Автоустановка с отключением своего маршрута" Checked="AutoInstallUpdates_Changed" Unchecked="AutoInstallUpdates_Changed" Margin="0,14,0,0"/><WrapPanel Margin="0,14,0,0"><Button Content="Проверить обновления" Click="CheckUpdates_Click" Margin="0,0,10,10"/><Button Content="История выпусков" Click="OpenReleases_Click" Margin="0,0,10,10"/><Button x:Name="DownloadUpdateButton" Content="Загрузить обновление" Click="DownloadUpdate_Click" Visibility="Collapsed" Margin="0,0,10,10"/><Button x:Name="InstallUpdateButton" Content="Установить и открыть" Click="InstallUpdate_Click" Visibility="Collapsed" Margin="0,0,0,10"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="О CITA Route" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Версия 0.5.3 · Windows desktop" Margin="0,14,0,0"/><TextBlock Text="Маршрутизатор sing-box 1.14.3 · VPN-соединение WireSock" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/><TextBlock Text="В режиме Авто маршруты проверяются параллельно с приоритетом прямого доступа. Проверка HTTPS не подтверждает работу всех функций сервиса." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/><Button Content="Открыть инструкцию" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OpenReadme_Click"/></StackPanel></Border>
          </StackPanel></ScrollViewer></TabItem>
        </TabControl>
        <DockPanel Grid.Row="4" Margin="30,0"><TextBlock x:Name="FooterStatus" Text="Проверка компонентов…" FontSize="10" Foreground="#8D8580" VerticalAlignment="Center"/><TextBlock Text="CITA // ROUTE TERMINAL" FontFamily="Consolas" FontSize="10" Foreground="#8D8580" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
      </Grid>
    </Grid>
    <Grid x:Name="CompactHost">
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
      <Grid Background="Transparent" MouseLeftButtonDown="TitleDrag" Margin="16,0,8,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="CITA / ROUTE" FontFamily="Consolas" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="⋮" Width="34" Padding="0" Background="Transparent" BorderThickness="0" Click="CompactMenu_Click" AutomationProperties.Name="Меню CITA Route" ToolTip="Меню и расширенный вид"/>
          <Button Content="—" Width="34" Padding="0" Background="Transparent" BorderThickness="0" Click="Minimize_Click" AutomationProperties.Name="Свернуть"/>
          <Button Content="×" FontSize="19" Width="34" Padding="0" Background="Transparent" BorderThickness="0" Click="Close_Click" AutomationProperties.Name="Скрыть в трей"/>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="22,16,22,12">
        <StackPanel Orientation="Horizontal"><Rectangle x:Name="CompactDot" Width="7" Height="7" Fill="{StaticResource Muted}" Margin="0,0,9,0"/><TextBlock Text="АВТОМАТИЧЕСКИЙ МАРШРУТ" Style="{StaticResource Eyebrow}" FontSize="10"/></StackPanel>
        <TextBlock x:Name="CompactState" Text="Отключено" FontFamily="Bahnschrift SemiCondensed" FontSize="30" Margin="-1,7,0,0" TextTrimming="CharacterEllipsis"/>
        <Button x:Name="CompactProfileButton" Click="ChooseCompactProfile_Click" Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{StaticResource Line}" Padding="0,8,0,12" HorizontalContentAlignment="Stretch" Margin="0,0,0,16" AutomationProperties.Name="Выбрать профиль">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CompactProfile" Text="Профиль будет найден при подключении" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="⌄" Foreground="{StaticResource Accent}" Margin="8,0,0,0"/></Grid>
        </Button>
        <Button x:Name="CompactConnectButton" Content="Подключить" Style="{StaticResource Primary}" Height="44" Click="Connect_Click" AutomationProperties.Name="Подключение CITA Route"/>
        <Grid Margin="0,22,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,8,18"><TextBlock Text="↓ ЗАГРУЗКА" Style="{StaticResource Eyebrow}" FontSize="9"/><TextBlock x:Name="CompactDownload" Text="—" FontFamily="Consolas" FontSize="19" Margin="0,5,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,18"><TextBlock Text="↑ ОТДАЧА" Style="{StaticResource Eyebrow}" FontSize="9"/><TextBlock x:Name="CompactUpload" Text="—" FontFamily="Consolas" FontSize="19" Margin="0,5,0,0"/></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,0,8,0"><TextBlock Text="ТРАФИК СЕССИИ" Style="{StaticResource Eyebrow}" FontSize="9"/><TextBlock x:Name="CompactTraffic" Text="—" FontFamily="Consolas" FontSize="17" Margin="0,5,0,0"/></StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="ВРЕМЯ СЕССИИ" Style="{StaticResource Eyebrow}" FontSize="9"/><TextBlock x:Name="CompactUptime" Text="—" FontFamily="Consolas" FontSize="17" Margin="0,5,0,0"/></StackPanel>
        </Grid>
        <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,12,0,0">
          <StackPanel>
            <TextBlock Text="ТУННЕЛЬ VPN / WIRESOCK" Style="{StaticResource Eyebrow}" FontSize="9"/>
            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="CompactVpnRtt" Text="Задержка: —" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="CompactVpnLoss" Grid.Column="1" Text="Потери: —" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource Muted}" Margin="8,0,0,0"/></Grid>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource PanelSoft}" Padding="16,10,16,9">
        <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="CompactStage" Text="Готово к подключению" FontSize="11" TextWrapping="Wrap" MaxHeight="34" VerticalAlignment="Center"/>
          <StackPanel Grid.Row="1"><TextBlock Text="Ограниченные → VPN · Остальное напрямую" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><ProgressBar x:Name="CompactActivity" Height="2" Margin="0,4,0,0" Visibility="Collapsed" Foreground="{StaticResource Accent}" Background="Transparent" BorderThickness="0"/></StackPanel>
        </Grid>
      </Border>
    </Grid>
    </Grid>
  </Border>
</Window>
